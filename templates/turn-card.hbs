<div class="hazarder-card hz-turn" data-token-uuid="{{tokenUuid}}">
  <header class="hz-header" data-hz-action="toggle-collapse">
    <span class="hz-header-icon"><i class="fa-solid fa-hourglass-half"></i></span>
    <span class="hz-header-name">{{title}}</span>
    {{#if roundLabel}}<span class="hz-badge hz-badge-round">{{roundLabel}}</span>{{/if}}
    <i class="fa-solid fa-chevron-down hz-collapse-icon"></i>
  </header>
  <div class="hz-body">
  {{#if traits.length}}
    <div class="hz-traits">{{#each traits}}<span class="hz-trait" data-trait="{{slug}}">{{label}}</span>{{/each}}</div>
  {{/if}}
  {{#if total}}
    <div class="hz-pool" data-remaining="{{remaining}}">
      {{#each pips}}<span class="hz-action-pip {{#if lost}}lost{{/if}}" {{#unless lost}}data-hz-action="spend" data-index="{{index}}"{{/unless}}></span>{{/each}}
      <span class="hz-pool-note hz-used"></span>
      {{#if disabledNote}}<span class="hz-pool-note">· {{disabledNote}}</span>{{/if}}
    </div>
  {{/if}}
  {{#unless routineEmpty}}<div class="hz-routine">{{{routineHtml}}}</div>{{/unless}}
  {{#if saves.length}}
    <div class="hz-saves">
      {{#each saves}}<button type="button" class="hz-save" data-tooltip="{{localize 'PF2E_HAZARDER.Turn.SaveForTargets'}}" data-hz-action="save-targets" data-save-index="{{@index}}" data-token-uuid="{{../tokenUuid}}"><i class="fa-solid fa-crosshairs"></i> {{#if basic}}{{localize "PF2E_HAZARDER.Turn.Basic"}} {{/if}}{{label}} <span class="hz-dc">DC {{dc}}</span></button>{{/each}}
    </div>
  {{/if}}
  {{#if outcomesHtml}}
    <details class="hz-outcomes">
      <summary>{{localize "PF2E_HAZARDER.Turn.Outcomes"}}</summary>
      <div class="hz-routine">{{{outcomesHtml}}}</div>
    </details>
  {{/if}}
  {{#each strikes}}
    <div class="hz-strike">
      <span class="hz-strike-name">
        <i class="fa-solid fa-hand-fist"></i> {{name}}
        <button type="button" class="hz-info-inline" data-hz-action="item-info" data-item-id="{{id}}" data-token-uuid="{{../tokenUuid}}" data-tooltip="{{localize 'PF2E_HAZARDER.Turn.Details'}}" aria-label="{{localize 'PF2E_HAZARDER.Turn.Details'}}"><i class="fa-solid fa-circle-info"></i></button>
      </span>
      <div class="hz-strike-buttons">
        {{#each variants}}<button type="button" class="hz-chip hz-attack" data-hz-action="strike" data-item-id="{{../id}}" data-variant="{{index}}" data-token-uuid="{{../../tokenUuid}}">{{label}}</button>{{/each}}
        {{#if hasDamage}}
          <button type="button" class="hz-chip hz-damage" data-hz-action="strike-damage" data-item-id="{{id}}" data-token-uuid="{{../tokenUuid}}">{{localize "PF2E_HAZARDER.Turn.Damage"}}</button>
          <button type="button" class="hz-chip hz-damage" data-hz-action="strike-critical" data-item-id="{{id}}" data-token-uuid="{{../tokenUuid}}">{{localize "PF2E_HAZARDER.Turn.Critical"}}</button>
        {{/if}}
      </div>
    </div>
  {{/each}}
  {{#each items}}
    <details class="hz-action" {{#if open}}open{{/if}}>
      <summary class="hz-action-head">
        <span class="hz-action-name">{{#if cost}}<span class="action-glyph">{{cost}}</span>{{else}}<i class="fa-solid fa-bolt"></i>{{/if}} {{name}}</span>
        <span class="hz-action-tools">
          <button type="button" class="hz-icon-btn" data-hz-action="item" data-item-id="{{id}}" data-token-uuid="{{../tokenUuid}}" data-tooltip="{{localize 'PF2E_HAZARDER.Turn.PostAction'}}" aria-label="{{localize 'PF2E_HAZARDER.Turn.PostAction'}}"><i class="fa-solid fa-comment-dots"></i></button>
          <button type="button" class="hz-icon-btn" data-hz-action="item-info" data-item-id="{{id}}" data-token-uuid="{{../tokenUuid}}" data-tooltip="{{localize 'PF2E_HAZARDER.Turn.Details'}}" aria-label="{{localize 'PF2E_HAZARDER.Turn.Details'}}"><i class="fa-solid fa-info"></i></button>
        </span>
      </summary>
      {{#if descriptionHtml}}<div class="hz-action-body">{{{descriptionHtml}}}</div>{{/if}}
      {{#if saves.length}}
        <div class="hz-saves">
          {{#each saves}}<button type="button" class="hz-save" data-tooltip="{{localize 'PF2E_HAZARDER.Turn.SaveForTargets'}}" data-hz-action="save-targets" data-item-id="{{../id}}" data-save-index="{{index}}" data-token-uuid="{{../../tokenUuid}}"><i class="fa-solid fa-crosshairs"></i> {{#if basic}}{{localize "PF2E_HAZARDER.Turn.Basic"}} {{/if}}{{label}} <span class="hz-dc">DC {{dc}}</span></button>{{/each}}
        </div>
      {{/if}}
    </details>
  {{/each}}
  </div>
</div>
