{
  "name": "pf2e-hazarder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "jest --maxWorkers=50%",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "fixtures": "node tools/extract-hazard-fixtures.mjs",
    "test:live": "node tests/live/run.mjs",
    "test:live:cleanup": "node tests/live/run.mjs --cleanup-only",
    "prepare": "husky"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.7.2",
    "@babel/core": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@eslint/js": "^9.35.0",
    "babel-jest": "^30.1.2",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "playwright": "^1.63.0",
    "prettier": "^3.6.2"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/live/"
    ]
  }
}
